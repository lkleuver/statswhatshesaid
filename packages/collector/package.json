{
  "name": "statswhatshesaid-collector",
  "version": "0.2.0",
  "description": "External one-shot CLI that polls one or more statswhatshesaid instances and persists results to a local SQLite database.",
  "license": "MIT",
  "author": "Les Kleuver <les.kleuver@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkleuver/statswhatshesaid.git",
    "directory": "packages/collector"
  },
  "bugs": {
    "url": "https://github.com/lkleuver/statswhatshesaid/issues"
  },
  "homepage": "https://github.com/lkleuver/statswhatshesaid#readme",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "swhsd-collect": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "statswhatshesaid",
    "stats",
    "analytics",
    "collector",
    "sqlite",
    "cli"
  ],
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@swhsd/hll": "*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
