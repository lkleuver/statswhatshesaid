{
  "name": "statswhatshesaid-monorepo",
  "private": true,
  "description": "Monorepo for the statswhatshesaid library and its companion collector CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run verify && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0"
  }
}
